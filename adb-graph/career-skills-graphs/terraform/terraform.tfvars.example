# Copy this file to terraform.tfvars or provide an approved .tfvars file.
# Do not commit credentials, private keys, wallet files, or generated SQL.

oci_tenancy_ocid     = "ocid1.tenancy.oc1..example"
oci_user_ocid        = "ocid1.user.oc1..example"
oci_compartment_ocid = "ocid1.compartment.oc1..example"
oci_region_identifier = "us-ashburn-1"

# Use a unique suffix for the LiveLabs tenancy or voucher.
res_id = "GHC"

# Set LICENSE_INCLUDED if the tenancy does not have BYOL entitlement.
license_model = "BRING_YOUR_OWN_LICENSE"

# Restrict this list for anything other than an instructor-led workshop.
whitelisted_ips = ["0.0.0.0/0"]

# Optional: use a pre-approved password instead of Terraform-generated values.
# adb_admin_password = ""
# ghc_dev_password   = ""

# Optional: use an existing consolidated career schema/data/graph/package script.
# The path is relative to this terraform directory unless absolute.
# career_bootstrap_sql = "db_scripts/career_bootstrap.sql"

# Load the bundled O*NET SQL archive and Abilities.xlsx extract into GHC_DEV.
load_bundled_career_data = true
