SET TERMOUT ON
SET ECHO ON
WHENEVER OSERROR EXIT FAILURE
WHENEVER SQLERROR EXIT SQL.SQLCODE

-- Schema-private RDF objects must be created while connected as their
-- intended owner. The network's RDF_VALUE$ table is a documented marker for
-- a network that was already created by a previous retry.
DECLARE
  l_network_count NUMBER;
BEGIN
  SELECT COUNT(*)
    INTO l_network_count
    FROM user_tables
   WHERE table_name = 'F1_NET#RDF_VALUE$';

  IF l_network_count = 0 THEN
    SEM_APIS.CREATE_RDF_NETWORK(
      'DATA',
      network_owner => '${f1_user_name}',
      network_name  => 'F1_NET'
    );
  END IF;
END;
/

-- USER_VIEWS contains the RDF table view created for the graph. Checking it
-- makes this step safe when a previous attempt created the graph already.
DECLARE
  l_graph_count NUMBER;
BEGIN
  SELECT COUNT(*)
    INTO l_graph_count
    FROM user_views
   WHERE view_name = 'F1_NET#RDFT_F1_2026_GRAPH';

  IF l_graph_count = 0 THEN
    SEM_APIS.CREATE_RDF_GRAPH(
      'F1_2026_GRAPH',
      NULL,
      NULL,
      network_owner => '${f1_user_name}',
      network_name  => 'F1_NET'
    );
  END IF;
END;
/

EXIT;
