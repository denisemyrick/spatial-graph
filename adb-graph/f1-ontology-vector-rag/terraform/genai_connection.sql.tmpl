SET TERMOUT ON
SET ECHO ON
WHENEVER OSERROR EXIT FAILURE
WHENEVER SQLERROR EXIT SQL.SQLCODE

%{ if api_key_configured ~}
-- Follow the LiveStack Finance bootstrap: create the OCI signing credential
-- generated by Terraform before creating the AI profiles.
DECLARE
  l_credential_count NUMBER;
  l_private_key     CLOB := q'~${private_key_pem}~';
BEGIN
  SELECT COUNT(*)
    INTO l_credential_count
    FROM user_credentials
   WHERE credential_name = 'AI_CREDENTIAL';

  IF l_credential_count > 0 THEN
    DBMS_CLOUD.DROP_CREDENTIAL(credential_name => 'AI_CREDENTIAL');
  END IF;

  DBMS_CLOUD.CREATE_CREDENTIAL(
    credential_name => 'AI_CREDENTIAL',
    user_ocid       => '${oci_user_ocid}',
    tenancy_ocid    => '${oci_tenancy_ocid}',
    private_key     => l_private_key,
    fingerprint     => '${fingerprint}'
  );
END;
/
PROMPT Created DBMS_CLOUD credential AI_CREDENTIAL
%{ endif ~}

-- Recreate the profiles so a rerun picks up the current OCI credential
-- configuration.
DECLARE
  l_profile_count NUMBER;
BEGIN
  SELECT COUNT(*)
    INTO l_profile_count
    FROM user_cloud_ai_profiles
   WHERE profile_name = UPPER('${genai_profile_name}');

  IF l_profile_count > 0 THEN
    DBMS_CLOUD_AI.DROP_PROFILE(
      profile_name => '${genai_profile_name}',
      force        => TRUE
    );
  END IF;
END;
/

DECLARE
  l_profile_count NUMBER;
BEGIN
  SELECT COUNT(*)
    INTO l_profile_count
    FROM user_cloud_ai_profiles
   WHERE profile_name = UPPER('${embedding_profile_name}');

  IF l_profile_count > 0 THEN
    DBMS_CLOUD_AI.DROP_PROFILE(
      profile_name => '${embedding_profile_name}',
      force        => TRUE
    );
  END IF;
END;
/

BEGIN
  DBMS_CLOUD_AI.CREATE_PROFILE(
    profile_name => '${genai_profile_name}',
    attributes   =>
      '{
        "provider": "oci",
        "credential_name": "${genai_credential_name}",
        "comments": "true",
        "oci_compartment_id": "${oci_compartment_ocid}"
      }'
  );
END;
/
PROMPT Created DBMS_CLOUD_AI profile ${genai_profile_name}

BEGIN
  DBMS_CLOUD_AI.CREATE_PROFILE(
    profile_name => '${embedding_profile_name}',
    attributes   =>
      '{
        "provider": "oci",
        "credential_name": "${genai_credential_name}",
        "oci_compartment_id": "${oci_compartment_ocid}",
        "region": "${oci_genai_region}",
        "embedding_model": "cohere.embed-v4.0"
      }'
  );
END;
/
PROMPT Created DBMS_CLOUD_AI profile ${embedding_profile_name}

EXIT;
