SET TERMOUT ON
SET ECHO ON
WHENEVER OSERROR EXIT FAILURE
WHENEVER SQLERROR EXIT SQL.SQLCODE

-- Create the workshop schema. The conditional block makes the bootstrap
-- safe to rerun after a partially completed stack job.
DECLARE
  l_user_count NUMBER;
BEGIN
  SELECT COUNT(*)
    INTO l_user_count
    FROM dba_users
   WHERE username = '${f1_user_name}';

  IF l_user_count = 0 THEN
    EXECUTE IMMEDIATE 'CREATE USER ${f1_user_name} IDENTIFIED BY "${user_password}"';
  ELSE
    EXECUTE IMMEDIATE 'ALTER USER ${f1_user_name} IDENTIFIED BY "${user_password}" ACCOUNT UNLOCK';
  END IF;
END;
/

-- Core schema privileges needed by the hands-on SQL labs.
-- CONNECT and RESOURCE match the RDF schema-private setup baseline. The
-- explicit grants below keep the required workshop capabilities visible.
GRANT CONNECT TO ${f1_user_name};
GRANT RESOURCE TO ${f1_user_name};
GRANT CREATE SESSION TO ${f1_user_name};
GRANT CREATE TABLE TO ${f1_user_name};
GRANT CREATE PROCEDURE TO ${f1_user_name};
GRANT CREATE VIEW TO ${f1_user_name};
GRANT UNLIMITED TABLESPACE TO ${f1_user_name};
ALTER USER ${f1_user_name} QUOTA UNLIMITED ON DATA;

-- Graph Studio requires the graph developer role, proxy authentication, and
-- an ORDS schema mapping for the learner account. These statements are
-- intentionally part of the ADMIN bootstrap so a new stack is usable without
-- a separate manual Graph Studio setup step.
GRANT GRAPH_DEVELOPER TO ${f1_user_name};
ALTER USER ${f1_user_name} GRANT CONNECT THROUGH "GRAPH$PROXY_USER";

BEGIN
  ORDS.ENABLE_SCHEMA(
    p_enabled             => TRUE,
    p_schema              => '${f1_user_name}',
    p_url_mapping_type    => 'BASE_PATH',
    p_url_mapping_pattern => '${f1_user_name}',
    p_auto_rest_auth      => FALSE
  );
  COMMIT;
END;
/

%{ if enable_oracle_java ~}
-- SEM_MATCH uses the Oracle JVM. ADB installs the feature asynchronously and
-- requires one database restart before the component becomes VALID.
DECLARE
  l_java_status dba_registry.status%TYPE;
BEGIN
  BEGIN
    SELECT status
      INTO l_java_status
      FROM dba_registry
     WHERE comp_id = 'JAVAVM';
  EXCEPTION
    WHEN NO_DATA_FOUND THEN
      l_java_status := NULL;
  END;

  IF l_java_status IS NULL OR l_java_status NOT IN ('VALID', 'LOADING') THEN
    DBMS_CLOUD_ADMIN.ENABLE_FEATURE(feature_name => 'JAVAVM');
  END IF;
END;
/
PROMPT Oracle JVM enablement was requested. Restart the Autonomous Database once after this bootstrap and wait for JAVAVM to become VALID.
%{ endif ~}

-- SQL/PLSQL document pipeline.
GRANT EXECUTE ON DBMS_VECTOR_CHAIN TO ${f1_user_name};
GRANT EXECUTE ON DBMS_CLOUD_AI TO ${f1_user_name};

-- Needed when the learner retrieves PDFs with DBMS_CLOUD.GET_OBJECT.
GRANT EXECUTE ON DBMS_CLOUD TO ${f1_user_name};

-- DBMS_CLOUD_AI and DBMS_CLOUD use outbound HTTPS.  The ACL is applied by
-- ADMIN to the learner schema so the GenAI profile can reach the OCI endpoint.
-- Keep this block idempotent because Resource Manager may retry the bootstrap.
DECLARE
  l_acl_count NUMBER;
BEGIN
  SELECT COUNT(*)
    INTO l_acl_count
    FROM dba_host_aces
   WHERE UPPER(host) = UPPER('${genai_host}')
     AND UPPER(principal) = UPPER('${f1_user_name}')
     AND UPPER(privilege) = 'HTTP'
     AND UPPER(grant_type) = 'GRANT';

  IF l_acl_count = 0 THEN
    DBMS_NETWORK_ACL_ADMIN.APPEND_HOST_ACE(
      host => '${genai_host}',
      ace  => xs$ace_type(
        privilege_list => xs$name_list('http'),
        principal_name => '${f1_user_name}',
        principal_type => xs_acl.ptype_db
      )
    );
  END IF;
END;
/

%{ if !api_key_configured ~}
-- Enable the Autonomous Database resource principal for OCI Generative AI.
-- OCI$RESOURCE_PRINCIPAL is system-defined; no user-created OCI API key is
-- required for the DBMS_CLOUD credential.
DECLARE
  l_credential_count NUMBER;
  l_grant_count      NUMBER;
BEGIN
  SELECT COUNT(*)
    INTO l_credential_count
    FROM dba_credentials
   WHERE owner = 'ADMIN'
     AND credential_name = 'OCI$RESOURCE_PRINCIPAL';

  IF l_credential_count = 0 THEN
    DBMS_CLOUD_ADMIN.ENABLE_PRINCIPAL_AUTH(provider => 'OCI');
  END IF;

  SELECT COUNT(*)
    INTO l_grant_count
    FROM dba_tab_privs
   WHERE grantee = '${f1_user_name}'
     AND owner = 'ADMIN'
     AND table_name = 'OCI$RESOURCE_PRINCIPAL';

  IF l_grant_count = 0 THEN
    DBMS_CLOUD_ADMIN.ENABLE_RESOURCE_PRINCIPAL(
      username => '${f1_user_name}'
    );
  END IF;
END;
/
%{ endif ~}

-- RDF graph network, graph creation, loading, and query operations.
GRANT EXECUTE ON MDSYS.RDF_APIS TO ${f1_user_name};

EXIT;
